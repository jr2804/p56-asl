# temp folders
/.tmp
/tmp
/temp
/ref

# Machine-local MCP tool config
/config/

# G.191 sv56demo generated outputs (regenerable from ref/ STL, not used by tests)
/tests/data/*.ref
!/tests/data/*.log.ref
/tests/data/*.nrm
/tests/data/*.ltl
/tests/data/voice_24.src
/tests/data/voice_32.src

# Copier answers (regenerated on update)
.copier-answers.yml

# MCP / coding assistant directories
.vscode
opencode.json
.opencode

# Skills lock file
skills-lock.json

# GrepAI config directory
.grepai/

# .agents/ DOX files — track .md and history/, ignore everything else tools may drop
/.agents/*
!/.agents/*.md
!/.agents/history/
!/.agents/history/**
# Implementation plans — mutable working artifacts, never committed
/.agents/plans/

# debug artifacts
*.pdb
